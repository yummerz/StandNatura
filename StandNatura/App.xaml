<Application x:Class="StandNatura.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:StandNatura.Views"
             xmlns:vm="clr-namespace:StandNatura.ViewModels"
             xmlns:converters="clr-namespace:StandNatura.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter"/>
        <converters:FilePathToImageConverter x:Key="FilePathToImageConverter"/>

        <!-- Admin Views -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdminHomeViewModel}">
            <views:AdminHomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VerifyPostsViewModel}">
            <views:VerifyPostsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManageUsersViewModel}">
            <views:ManageUsersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SightingFeedViewModel}">
            <views:SightingFeedView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DonationsFundsViewModel}">
            <views:DonationsFundsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HiddenSightingsViewModel}">
            <views:HiddenSightingsView/>
        </DataTemplate>

        <!-- Contributor Views -->
        <DataTemplate DataType="{x:Type vm:ContributorHomeViewModel}">
            <views:ContributorHomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubmitSightingViewModel}">
            <views:SubmitSightingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MySightingsViewModel}">
            <views:MySightingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HotspotMapViewModel}">
            <views:HotspotMapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommunityFeedViewModel}">
            <views:CommunityFeedView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SightingDetailViewModel}">
            <views:SightingDetailView/>
        </DataTemplate>

    </Application.Resources>
</Application>