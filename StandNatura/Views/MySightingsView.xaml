<UserControl x:Class="StandNatura.Views.MySightingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="🌿 My Sightings"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#74C69D"
                       FontFamily="Trebuchet MS"/>
            <TextBlock Text="View and manage all your submitted sightings."
                       FontSize="13"
                       Foreground="#95D5B2"
                       FontFamily="Trebuchet MS"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: My Sightings List -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="My Submissions"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding MySightings}"
                         SelectedItem="{Binding SelectedSighting}"
                         Background="#2D6A4F"
                         Foreground="#D8F3DC"
                         BorderBrush="#52B788"
                         BorderThickness="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6,8,6">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DatePosted}"
                                           FontSize="11"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"/>
                                <!-- Status Badge -->
                                <TextBlock FontSize="12" FontWeight="Bold"
                                           FontFamily="Trebuchet MS">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Status}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                    <Setter Property="Foreground" Value="#52B788"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Denied">
                                                    <Setter Property="Foreground" Value="#E05C6E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Right: Sighting Details -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Sighting Details"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#2D6A4F"
                        BorderBrush="#52B788"
                        BorderThickness="2"
                        Padding="15">
                    <StackPanel>

                        <!-- No selection message -->
                        <TextBlock Text="Select a sighting from the list to view details."
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"
                                   FontSize="13"
                                   Visibility="{Binding SelectedSighting,
                                       Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Details panel -->
                        <StackPanel Visibility="{Binding SelectedSighting,
                                        Converter={StaticResource NotNullToVisibilityConverter}}">

                            <!-- Top: Title, Status and Photo side by side -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Title and Status -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding SelectedSighting.Title}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="#74C69D"
                                               FontFamily="Trebuchet MS"
                                               TextWrapping="Wrap"/>

                                    <!-- Status Badge -->
                                    <TextBlock FontSize="14" FontWeight="Bold"
                                               FontFamily="Trebuchet MS"
                                               Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding SelectedSighting.Status}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSighting.Status}" Value="Pending">
                                                        <Setter Property="Foreground" Value="#FFD700"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedSighting.Status}" Value="Approved">
                                                        <Setter Property="Foreground" Value="#52B788"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedSighting.Status}" Value="Denied">
                                                        <Setter Property="Foreground" Value="#E05C6E"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding SelectedSighting.DatePosted}"
                                               FontSize="12"
                                               Foreground="#95D5B2"
                                               FontFamily="Trebuchet MS"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Right: Photo Preview -->
                                <Border Grid.Column="1"
                                        Background="#1B4332"
                                        BorderBrush="#52B788"
                                        BorderThickness="2"
                                        Height="180">
                                    <Grid>
                                        <TextBlock Text="No Photo"
                                                   Foreground="#95D5B2"
                                                   FontFamily="Trebuchet MS"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding SelectedSighting.Photo,
                                                       Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding SelectedSighting.Photo, 
                                                Converter={StaticResource FilePathToImageConverter}}"
                                                Stretch="Uniform"
                                                Visibility="{Binding SelectedSighting.Photo,
                                                Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Divider -->
                            <Separator Background="#52B788" Margin="0,15,0,15"/>

                            <!-- Bottom: Full Details -->
                            <TextBlock Text="Description"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SelectedSighting.Description}"
                                       FontSize="13"
                                       Foreground="#D8F3DC"
                                       FontFamily="Trebuchet MS"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="Location"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,12,0,2"/>
                            <TextBlock Text="{Binding SelectedSighting.Location}"
                                       FontSize="13"
                                       Foreground="#D8F3DC"
                                       FontFamily="Trebuchet MS"/>

                            <TextBlock Text="Province / Region"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,12,0,2"/>
                            <TextBlock FontSize="13"
                                       Foreground="#D8F3DC"
                                       FontFamily="Trebuchet MS">
                                <Run Text="{Binding SelectedSighting.Province}"/>
                                <Run Text=" / "/>
                                <Run Text="{Binding SelectedSighting.Region}"/>
                            </TextBlock>

                            <TextBlock Text="Coordinates"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,12,0,2"/>
                            <TextBlock FontSize="13"
                                       Foreground="#D8F3DC"
                                       FontFamily="Trebuchet MS">
                                <Run Text="Lat: "/>
                                <Run Text="{Binding SelectedSighting.Latitude}"/>
                                <Run Text="  Long: "/>
                                <Run Text="{Binding SelectedSighting.Longitude}"/>
                            </TextBlock>
                            <!-- Denial Reason (only shows if denied) -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedSighting.Status}" Value="Denied">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="❌ Reason for Denial"
                                FontSize="12" FontWeight="Bold"
                                Foreground="#E05C6E"
                                FontFamily="Trebuchet MS"
                                Margin="0,12,0,2"/>
                                <Border Background="#1B4332"
                                    BorderBrush="#E05C6E"
                                    BorderThickness="2"
                                    Padding="10"
                                    Margin="0,0,0,5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedSighting.DenialReason}"
                                    FontSize="13"
                                    Foreground="#D8F3DC"
                                    FontFamily="Trebuchet MS"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding SelectedSighting.DenialReason, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                        <TextBlock Text="No reason was provided."
                                    FontSize="13"
                                    Foreground="#95D5B2"
                                    FontFamily="Trebuchet MS"
                                    FontStyle="Italic"
                                    Visibility="{Binding SelectedSighting.DenialReason, Converter={StaticResource NullToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>


                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
            Content="← Back"
            Height="45"
            Margin="0,0,5,0"
            Background="#2D6A4F"
            Foreground="#D8F3DC"
            FontFamily="Trebuchet MS"
            FontSize="14" FontWeight="Bold"
            BorderBrush="#52B788" BorderThickness="2"
            Command="{Binding GoBackCommand}"/>

            <Button Grid.Column="1"
            Content="📤 Quick Resubmit"
            Height="45"
            Margin="5,0,5,0"
            Background="#52B788"
            Foreground="#1B4332"
            FontFamily="Trebuchet MS"
            FontSize="13" FontWeight="Bold"
            BorderBrush="#74C69D" BorderThickness="2"
            Command="{Binding QuickResubmitCommand}"/>

            <Button Grid.Column="2"
            Content="✏️ Edit &amp; Resubmit"
            Height="45"
            Margin="5,0,5,0"
            Background="#52B788"
            Foreground="#1B4332"
            FontFamily="Trebuchet MS"
            FontSize="13" FontWeight="Bold"
            BorderBrush="#74C69D" BorderThickness="2"
            Command="{Binding EditAndResubmitCommand}"/>

            <Button Grid.Column="3"
            Content="🗑️ Delete"
            Height="45"
            Margin="5,0,0,0"
            Background="#B7374A"
            Foreground="#FFFFFF"
            FontFamily="Trebuchet MS"
            FontSize="14" FontWeight="Bold"
            BorderBrush="#E05C6E" BorderThickness="2"
            Command="{Binding DeleteSightingCommand}"/>
        </Grid>
    </Grid>
</UserControl>