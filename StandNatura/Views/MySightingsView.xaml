<UserControl x:Class="StandNatura.Views.MySightingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:v="clr-namespace:StandNatura.Views"
             mc:Ignorable="d">

    <!-- ============================================================
         MY SIGHTINGS VIEW
         Status-grouped card stream. Each section renders only if
         it has items (binding IsVisible to the Has* properties).
         Each card has inline actions appropriate to its status.
         ============================================================ -->

    <UserControl.Resources>

        <!-- Bool → Visibility converter (need to register this) -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Card container style -->
        <Style x:Key="SightingCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#1F4030" Opacity="0.85"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <SolidColorBrush Color="#5FA572" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status pill base style -->
        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4,10,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Section header style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9BB39E"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Primary action button (filled green) -->
        <Style x:Key="PrimaryActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#5FA572"/>
            <Setter Property="Foreground" Value="#0D2818"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action button (outlined) -->
        <Style x:Key="SecondaryActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D8E5DA"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#5FA572"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger button (outlined red, for destructive actions) -->
        <Style x:Key="DangerActionButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E05C6E"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#C45A3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <v:AppShell ActivePageKey="{Binding ActivePageKey}">
        <v:AppShell.PageContent>

            <Grid Background="#0D2818">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="40,30,40,40" MaxWidth="1100" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ─────────────────────────────────
                             ROW 0: Page heading
                             ───────────────────────────────── -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <TextBlock Text="🌿 My Sightings"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="#F5F0E8"
                                       FontFamily="Trebuchet MS"/>
                            <TextBlock Text="Manage your submissions and resubmit denied ones"
                                       FontSize="14"
                                       Foreground="#9BB39E"
                                       FontFamily="Trebuchet MS"
                                       FontStyle="Italic"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- ─────────────────────────────────
                             ROW 1: Content (sections OR empty state)
                             ───────────────────────────────── -->
                        <Grid Grid.Row="1">

                            <!-- ════════ EMPTY STATE ════════ -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,60,0,0"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="🌱"
                                           FontSize="72"
                                           HorizontalAlignment="Center"
                                           Opacity="0.6"/>
                                <TextBlock Text="No sightings yet"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#F5F0E8"
                                           FontFamily="Trebuchet MS"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,0"/>
                                <TextBlock Text="Share your first nature discovery with the community"
                                           FontSize="14"
                                           Foreground="#9BB39E"
                                           FontFamily="Trebuchet MS"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,24"/>
                                <Button Content="📍 Submit Your First Sighting"
                                        Height="46"
                                        Width="280"
                                        Background="#5FA572"
                                        Foreground="#0D2818"
                                        FontFamily="Trebuchet MS"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding GoToSubmitSightingCommand}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <!-- ════════ SECTIONS ════════ -->
                            <StackPanel>

                                <!-- ───── SECTION: NEEDS ATTENTION (Denied) ───── -->
                                <StackPanel Margin="0,0,0,30"
                                            Visibility="{Binding HasNeedsAttention, Converter={StaticResource BoolToVisibility}}">

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Run Text="🔔 NEEDS YOUR ATTENTION"
                                                 Foreground="#E05C6E"
                                                 FontWeight="Bold"/>
                                            <Run Text="(" Foreground="#9BB39E"/><Run Text="{Binding NeedsAttentionCount, Mode=OneWay}" Foreground="#9BB39E"/><Run Text=")" Foreground="#9BB39E"/>
                                            <TextBlock.FontSize>13</TextBlock.FontSize>
                                            <TextBlock.FontFamily>Trebuchet MS</TextBlock.FontFamily>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                Height="1"
                                                Background="#E05C6E"
                                                Opacity="0.3"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding NeedsAttentionSightings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SightingCard}">
                                                    <StackPanel>

                                                        <!-- Header row: photo + title + status pill -->
                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Photo thumbnail -->
                                                            <Border Grid.Column="0"
                                                                    Height="100"
                                                                    CornerRadius="6"
                                                                    Background="#0D2818"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="🌿"
                                                                               FontSize="32"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Opacity="0.4"
                                                                               Visibility="{Binding Photo, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                    <Image Source="{Binding Photo, Converter={StaticResource FilePathToImageConverter}}"
                                                                           Stretch="UniformToFill"
                                                                           Visibility="{Binding Photo, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Title + meta -->
                                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                                                                <Border Style="{StaticResource StatusPill}"
                                                                        Background="#E05C6E"
                                                                        Margin="0,0,0,8">
                                                                    <TextBlock Text="❌ DENIED"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#0D2818"
                                                                               FontFamily="Trebuchet MS"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#F5F0E8"
                                                                           FontFamily="Trebuchet MS"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="12"
                                                                           Foreground="#9BB39E"
                                                                           FontFamily="Trebuchet MS"
                                                                           Margin="0,6,0,0">
                                                                    <Run Text="📍 "/>
                                                                    <Run Text="{Binding Location}"/><Run Text=", "/><Run Text="{Binding Province}"/>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11"
                                                                           Foreground="#9BB39E"
                                                                           FontFamily="Trebuchet MS"
                                                                           Margin="0,3,0,0">
                                                                    <Run Text="Submitted "/>
                                                                    <Run Text="{Binding DatePosted}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Denial reason box -->
                                                        <Border CornerRadius="6"
                                                                BorderThickness="1"
                                                                Padding="14"
                                                                Margin="0,4,0,12">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="#E05C6E" Opacity="0.10"/>
                                                            </Border.Background>
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="#E05C6E" Opacity="0.5"/>
                                                            </Border.BorderBrush>
                                                            <StackPanel>
                                                                <TextBlock Text="❌ REASON FOR DENIAL"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#E05C6E"
                                                                           FontFamily="Trebuchet MS"/>
                                                                <TextBlock Text="{Binding DenialReason}"
                                                                           FontSize="13"
                                                                           Foreground="#F5F0E8"
                                                                           FontFamily="Trebuchet MS"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Action buttons -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="✏️ Edit &amp; Resubmit"
                                                                    Style="{StaticResource PrimaryActionButton}"
                                                                    Command="{Binding DataContext.EditAndResubmitCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="📤 Quick Resubmit"
                                                                    Style="{StaticResource SecondaryActionButton}"
                                                                    Command="{Binding DataContext.QuickResubmitCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button Content="🗑️ Delete"
                                                                    Style="{StaticResource DangerActionButton}"
                                                                    Command="{Binding DataContext.DeleteSightingCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ───── SECTION: AWAITING REVIEW (Pending) ───── -->
                                <StackPanel Margin="0,0,0,30"
                                            Visibility="{Binding HasAwaitingReview, Converter={StaticResource BoolToVisibility}}">

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Run Text="⏳ AWAITING REVIEW"
                                                 Foreground="#FFD700"
                                                 FontWeight="Bold"/>
                                            <Run Text="(" Foreground="#9BB39E"/><Run Text="{Binding AwaitingReviewCount, Mode=OneWay}" Foreground="#9BB39E"/><Run Text=")" Foreground="#9BB39E"/>
                                            <TextBlock.FontSize>13</TextBlock.FontSize>
                                            <TextBlock.FontFamily>Trebuchet MS</TextBlock.FontFamily>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                Height="1"
                                                Background="#FFD700"
                                                Opacity="0.3"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AwaitingReviewSightings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SightingCard}">
                                                    <StackPanel>

                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Height="100"
                                                                    CornerRadius="6"
                                                                    Background="#0D2818"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="🌿"
                                                                               FontSize="32"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Opacity="0.4"
                                                                               Visibility="{Binding Photo, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                    <Image Source="{Binding Photo, Converter={StaticResource FilePathToImageConverter}}"
                                                                           Stretch="UniformToFill"
                                                                           Visibility="{Binding Photo, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                                                                <Border Style="{StaticResource StatusPill}"
                                                                        Background="#FFD700"
                                                                        Margin="0,0,0,8">
                                                                    <TextBlock Text="⏳ PENDING"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#0D2818"
                                                                               FontFamily="Trebuchet MS"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#F5F0E8"
                                                                           FontFamily="Trebuchet MS"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="12"
                                                                           Foreground="#9BB39E"
                                                                           FontFamily="Trebuchet MS"
                                                                           Margin="0,6,0,0">
                                                                    <Run Text="📍 "/>
                                                                    <Run Text="{Binding Location}"/><Run Text=", "/><Run Text="{Binding Province}"/>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11"
                                                                           Foreground="#9BB39E"
                                                                           FontFamily="Trebuchet MS"
                                                                           Margin="0,3,0,0">
                                                                    <Run Text="Submitted "/>
                                                                    <Run Text="{Binding DatePosted}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Action buttons (Pending: only Delete) -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="🗑️ Delete"
                                                                    Style="{StaticResource DangerActionButton}"
                                                                    Command="{Binding DataContext.DeleteSightingCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ───── SECTION: LIVE IN FEED (Approved) ───── -->
                                <StackPanel Margin="0,0,0,30"
                                            Visibility="{Binding HasLiveInFeed, Converter={StaticResource BoolToVisibility}}">

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Run Text="✅ LIVE IN FEED"
                                                 Foreground="#5FA572"
                                                 FontWeight="Bold"/>
                                            <Run Text="(" Foreground="#9BB39E"/><Run Text="{Binding LiveInFeedCount, Mode=OneWay}" Foreground="#9BB39E"/><Run Text=")" Foreground="#9BB39E"/>
                                            <TextBlock.FontSize>13</TextBlock.FontSize>
                                            <TextBlock.FontFamily>Trebuchet MS</TextBlock.FontFamily>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                Height="1"
                                                Background="#5FA572"
                                                Opacity="0.3"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding LiveInFeedSightings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SightingCard}">
                                                    <StackPanel>

                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Height="100"
                                                                    CornerRadius="6"
                                                                    Background="#0D2818"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="🌿"
                                                                               FontSize="32"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Opacity="0.4"
                                                                               Visibility="{Binding Photo, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                    <Image Source="{Binding Photo, Converter={StaticResource FilePathToImageConverter}}"
                                                                           Stretch="UniformToFill"
                                                                           Visibility="{Binding Photo, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                                                                <Border Style="{StaticResource StatusPill}"
                                                                        Background="#52B788"
                                                                        Margin="0,0,0,8">
                                                                    <TextBlock Text="✅ APPROVED"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#0D2818"
                                                                               FontFamily="Trebuchet MS"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#F5F0E8"
                                                                           FontFamily="Trebuchet MS"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="12"
                                                                           Foreground="#9BB39E"
                                                                           FontFamily="Trebuchet MS"
                                                                           Margin="0,6,0,0">
                                                                    <Run Text="📍 "/>
                                                                    <Run Text="{Binding Location}"/><Run Text=", "/><Run Text="{Binding Province}"/>
                                                                </TextBlock>
                                                                <TextBlock FontSize="11"
                                                                           Foreground="#9BB39E"
                                                                           FontFamily="Trebuchet MS"
                                                                           Margin="0,3,0,0">
                                                                    <Run Text="Submitted "/>
                                                                    <Run Text="{Binding DatePosted}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Action buttons (Approved: View in Feed) -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="View in Feed →"
                                                                    Style="{StaticResource PrimaryActionButton}"
                                                                    Command="{Binding DataContext.ViewInFeedCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- ───── SECTION: ARCHIVED ───── -->
                                <StackPanel Margin="0,0,0,30"
                                            Visibility="{Binding HasArchived, Converter={StaticResource BoolToVisibility}}">

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0">
                                            <Run Text="📦 ARCHIVED"
                                                 Foreground="#9D4DCC"
                                                 FontWeight="Bold"/>
                                            <Run Text="(" Foreground="#9BB39E"/><Run Text="{Binding ArchivedCount, Mode=OneWay}" Foreground="#9BB39E"/><Run Text=")" Foreground="#9BB39E"/>
                                            <TextBlock.FontSize>13</TextBlock.FontSize>
                                            <TextBlock.FontFamily>Trebuchet MS</TextBlock.FontFamily>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                Height="1"
                                                Background="#9D4DCC"
                                                Opacity="0.3"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding ArchivedSightings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SightingCard}">
                                                    <StackPanel>

                                                        <Grid Margin="0,0,0,12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="120"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border Grid.Column="0"
                                                                    Height="100"
                                                                    CornerRadius="6"
                                                                    Background="#0D2818"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="🌿"
                                                                               FontSize="32"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Opacity="0.4"
                                                                               Visibility="{Binding Photo, Converter={StaticResource NullToVisibilityConverter}}"/>
                                                                    <Image Source="{Binding Photo, Converter={StaticResource FilePathToImageConverter}}"
                                                                           Stretch="UniformToFill"
                                                                           Visibility="{Binding Photo, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                                                                <Border Style="{StaticResource StatusPill}"
                                                                        Background="#9D4DCC"
                                                                        Margin="0,0,0,8">
                                                                    <TextBlock Text="📦 ARCHIVED"
                                                                               FontSize="10"
                                                                               FontWeight="Bold"
                                                                               Foreground="#F5F0E8"
                                                                               FontFamily="Trebuchet MS"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title}"
                                                                           FontSize="18"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#F5F0E8"
                                                                           FontFamily="Trebuchet MS"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="12"
                                                                           Foreground="#9BB39E"
                                                                           FontFamily="Trebuchet MS"
                                                                           Margin="0,6,0,0">
                                                                    <Run Text="📍 "/>
                                                                    <Run Text="{Binding Location}"/><Run Text=", "/><Run Text="{Binding Province}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Archive reason box -->
                                                        <Border CornerRadius="6"
                                                                BorderThickness="1"
                                                                Padding="14"
                                                                Margin="0,4,0,12">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="#9D4DCC" Opacity="0.10"/>
                                                            </Border.Background>
                                                            <Border.BorderBrush>
                                                                <SolidColorBrush Color="#9D4DCC" Opacity="0.5"/>
                                                            </Border.BorderBrush>
                                                            <StackPanel>
                                                                <TextBlock Text="📦 REASON FOR ARCHIVE"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#9D4DCC"
                                                                           FontFamily="Trebuchet MS"/>
                                                                <TextBlock Text="{Binding ArchiveReason}"
                                                                           FontSize="13"
                                                                           Foreground="#F5F0E8"
                                                                           FontFamily="Trebuchet MS"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Action buttons (Archived: only Edit & Resubmit) -->
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="✏️ Edit &amp; Resubmit"
                                                                    Style="{StaticResource PrimaryActionButton}"
                                                                    Command="{Binding DataContext.EditAndResubmitCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>

                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </v:AppShell.PageContent>
    </v:AppShell>
</UserControl>