<UserControl x:Class="StandNatura.Views.ManageUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="👤 Manage Users"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#74C69D"
                       FontFamily="Trebuchet MS"/>
            <TextBlock Text="View, add, or remove user accounts."
                       FontSize="13"
                       Foreground="#95D5B2"
                       FontFamily="Trebuchet MS"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: User List -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="All Users"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Users}"
                         SelectedItem="{Binding SelectedUser}"
                         Background="#2D6A4F"
                         Foreground="#D8F3DC"
                         BorderBrush="#52B788"
                         BorderThickness="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6,8,6">
                                <TextBlock Text="{Binding Username}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS"/>
                                <TextBlock Text="{Binding Role}"
                                           FontSize="12"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"/>
                                <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}"
                                           FontSize="11"
                                           Foreground="#74C69D"
                                           FontFamily="Trebuchet MS"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Right: Add User Form -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Add New User"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#2D6A4F"
                        BorderBrush="#52B788"
                        BorderThickness="2"
                        Padding="15">
                    <StackPanel>

                        <!-- Username -->
                        <TextBlock Text="Username"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,0,0,5"/>
                        <TextBox Background="#1B4332"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#52B788"
                                 BorderThickness="2"
                                 Padding="5,8,5,8"
                                 FontSize="13"
                                 FontFamily="Trebuchet MS"
                                 Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Password -->
                        <TextBlock Text="Password"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,15,0,5"/>
                        <PasswordBox x:Name="NewPasswordInput"
                                     Background="#1B4332"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#52B788"
                                     BorderThickness="2"
                                     Padding="5,8,5,8"
                                     FontSize="13"/>

                        <!-- Role -->
                        <TextBlock Text="Role"
                            FontSize="13" FontWeight="Bold"
                            Foreground="#95D5B2"
                            FontFamily="Trebuchet MS"
                            Margin="0,15,0,5"/>
                        <ComboBox Background="#1B4332"
                            Foreground="#1B4332"
                            BorderBrush="#52B788"
                            BorderThickness="2"
                            Padding="5,8,5,8"
                            FontSize="13"
                            FontFamily="Trebuchet MS"
                            ItemsSource="{Binding Roles}"
                            SelectedItem="{Binding NewRole}"/>

                        <!-- Add Button -->
                        <Button Content="➕ Add User"
                                Height="45"
                                Margin="0,25,0,0"
                                Background="#52B788"
                                Foreground="#1B4332"
                                FontFamily="Trebuchet MS"
                                FontSize="14" FontWeight="Bold"
                                BorderBrush="#74C69D" BorderThickness="2"
                                Command="{Binding AddUserCommand}"
                                Click="AddUserButton_Click"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Back"
                    Height="45"
                    Margin="0,0,10,0"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoBackCommand}"/>

            <Button Grid.Column="1"
                    Content="🗑️ Delete Selected User"
                    Height="45"
                    Background="#B7374A"
                    Foreground="#FFFFFF"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#E05C6E" BorderThickness="2"
                    Command="{Binding DeleteUserCommand}"/>
        </Grid>
    </Grid>
</UserControl>