<UserControl x:Class="StandNatura.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="1">
            <StackPanel Width="250" Height="600">

                <!-- Title -->
                <TextBlock Text="🌿 StandNatura"
                           FontSize="38" FontWeight="Bold"
                           Foreground="#74C69D"
                           HorizontalAlignment="Center"
                           FontFamily="Trebuchet MS"
                           Margin="0,40,0,0"/>

                <TextBlock Text="Create an Account"
                           FontSize="13"
                           Foreground="#95D5B2"
                           HorizontalAlignment="Center"
                           FontFamily="Trebuchet MS"
                           Margin="0,4,0,30"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,5"/>
                <TextBox Width="250"
                         Background="#2D6A4F"
                         Foreground="#FFFFFF"
                         BorderBrush="#52B788"
                         BorderThickness="2"
                         Padding="5,8,5,8"
                         FontSize="14"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,20,0,5"/>
                <PasswordBox x:Name="PasswordInput"
                             Width="250"
                             Background="#2D6A4F"
                             Foreground="#FFFFFF"
                             BorderBrush="#52B788"
                             BorderThickness="2"
                             Padding="5,8,5,8"
                             FontSize="14"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,20,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordInput"
                             Width="250"
                             Background="#2D6A4F"
                             Foreground="#FFFFFF"
                             BorderBrush="#52B788"
                             BorderThickness="2"
                             Padding="5,8,5,8"
                             FontSize="14"/>

                <!-- Register Button -->
                <Button Content="Create Account"
                        Width="250"
                        Margin="0,30,0,0"
                        Background="#52B788"
                        Foreground="#1B4332"
                        FontFamily="Trebuchet MS"
                        FontSize="15" FontWeight="Bold"
                        Padding="10,8,10,8"
                        BorderBrush="#74C69D" BorderThickness="2"
                        Command="{Binding RegisterCommand}"
                        Click="RegisterButton_Click"/>

                <!-- Back to Login -->
                <Button Content="← Back to Login"
                        Width="250"
                        Margin="0,10,0,0"
                        Background="Transparent"
                        Foreground="#74C69D"
                        FontFamily="Trebuchet MS"
                        FontSize="13"
                        Padding="10,8,10,8"
                        BorderThickness="0"
                        Command="{Binding GoBackCommand}"/>

            </StackPanel>
        </Viewbox>
    </Grid>
</UserControl>