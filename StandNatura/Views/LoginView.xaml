<UserControl x:Class="StandNatura.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             mc:Ignorable="d">

    <!-- ============================================================
         LOGIN VIEW
         Layered structure (back to front):
           1. Background photo
           2. Vignette       — dark gradient overlay for legibility
           3. Content        — brand block + frosted-glass form panel
         ============================================================ -->

    <Grid>

        <!-- ─────────────────────────────────────────────────
             LAYER 1: Background photo
             ───────────────────────────────────────────────── -->
        <Image Source="/Assets/LoginBackground.jpg"
               Stretch="UniformToFill"
               IsHitTestVisible="False"/>

        <!-- ─────────────────────────────────────────────────
             LAYER 2: Vignette overlay
             Subtle dark gradient at edges for cinematic depth.
             ───────────────────────────────────────────────── -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.85" RadiusY="0.85">
                    <GradientStop Color="#00000000" Offset="0.4"/>
                    <GradientStop Color="#80000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ─────────────────────────────────────────────────
             LAYER 3: Content (brand + form)
             ───────────────────────────────────────────────── -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="500">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">

                <!-- ── Brand block: backdrop + logo + wordmark + tagline ── -->
                <Border Padding="40,25,40,25"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                            <GradientStop Color="#660D2818" Offset="0"/>
                            <GradientStop Color="#330D2818" Offset="0.7"/>
                            <GradientStop Color="#000D2818" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Outlined Leaf Logo with stronger glow -->
                        <Grid Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Path Stroke="#5FA572"
                                  StrokeThickness="3.5"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  Data="M 50,5 C 20,15 5,40 10,75 C 40,75 75,55 80,15 C 70,12 60,10 50,5 Z M 18,68 C 35,55 55,40 65,20">
                                <Path.Effect>
                                    <DropShadowEffect Color="#5FA572"
                                                      BlurRadius="35"
                                                      ShadowDepth="0"
                                                      Opacity="0.85"/>
                                </Path.Effect>
                            </Path>
                        </Grid>

                        <!-- Wordmark — bolder, larger, with letter spacing -->
                        <TextBlock Text="StandNatura"
                                   FontSize="44"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F0E8"
                                   HorizontalAlignment="Center"
                                   FontFamily="Trebuchet MS"
                                   Typography.Capitals="AllSmallCaps">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#000000"
                                                  BlurRadius="15"
                                                  ShadowDepth="0"
                                                  Opacity="0.7"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Tagline with stacked glow effects -->
<Grid HorizontalAlignment="Center" Margin="0,2,0,0">

    <!-- Glow layer 1 (large amber halo) -->
    <TextBlock Text="Where nature finds its defenders"
               FontSize="14"
               Foreground="#D4A574"
               HorizontalAlignment="Center"
               FontFamily="Trebuchet MS"
               FontStyle="Italic">
        <TextBlock.Effect>
            <BlurEffect Radius="25"/>
        </TextBlock.Effect>
    </TextBlock>

    <!-- Glow layer 2 (medium amber halo) -->
    <TextBlock Text="Where nature finds its defenders"
               FontSize="14"
               Foreground="#D4A574"
               HorizontalAlignment="Center"
               FontFamily="Trebuchet MS"
               FontStyle="Italic">
        <TextBlock.Effect>
            <BlurEffect Radius="10"/>
        </TextBlock.Effect>
    </TextBlock>

    <!-- The actual readable text on top -->
    <TextBlock Text="Where nature finds its defenders"
               FontSize="14"
               Foreground="#F5E6CC"
               HorizontalAlignment="Center"
               FontFamily="Trebuchet MS"
               FontStyle="Italic">
        <TextBlock.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="8"
                              ShadowDepth="0"
                              Opacity="0.7"/>
        </TextBlock.Effect>
    </TextBlock>

</Grid>

                    </StackPanel>
                </Border>

                <!-- ── Frosted-glass form panel ── -->
                <Border Width="380"
                        Padding="35,30,35,30"
                        CornerRadius="8">
                    <Border.Background>
                        <SolidColorBrush Color="#1F4030" Opacity="0.7"/>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#5FA572" Opacity="0.4"/>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000"
                                          BlurRadius="30"
                                          ShadowDepth="0"
                                          Opacity="0.5"/>
                    </Border.Effect>

                    <StackPanel>

                        <!-- Form heading -->
                        <TextBlock Text="Welcome back"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F0E8"
                                   FontFamily="Trebuchet MS"/>
                        <TextBlock Text="Sign in to continue your work"
                                   FontSize="12"
                                   Foreground="#9BB39E"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,2,0,25"/>

                        <!-- Username -->
                        <TextBlock Text="USERNAME"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#9BB39E"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,0,0,6"/>
                        <Border Background="#330D2818"
                                BorderBrush="#5FA572"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBox Background="Transparent"
                                     Foreground="#F5F0E8"
                                     CaretBrush="#5FA572"
                                     BorderThickness="0"
                                     Padding="12,10,12,10"
                                     FontSize="14"
                                     FontFamily="Trebuchet MS"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#9BB39E"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,18,0,6"/>
                        <Border Background="#330D2818"
                                BorderBrush="#5FA572"
                                BorderThickness="1"
                                CornerRadius="4">
                            <PasswordBox x:Name="PasswordInput"
                                         Background="Transparent"
                                         Foreground="#F5F0E8"
                                         CaretBrush="#5FA572"
                                         BorderThickness="0"
                                         Padding="12,10,12,10"
                                         FontSize="14"
                                         FontFamily="Trebuchet MS"/>
                        </Border>

                        <!-- Sign In button -->
                        <!-- Custom template so the green Background shows in EVERY state
                             (resting/disabled/hover/pressed). The default WPF button
                             template paints its own disabled chrome (white/gray) and
                             ignores Background, which is why it looked white when the
                             fields were empty (LoginCommand disabled). -->
                        <Button Content="Sign In"
                                Margin="0,30,0,0"
                                Height="44"
                                Background="#40916C"
                                Foreground="#F5F0E8"
                                FontFamily="Trebuchet MS"
                                FontSize="14"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding LoginCommand}"
                                Click="LoginButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#52B788"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2D6A4F"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <!-- Still green, just dimmed to hint "not ready yet" -->
                                            <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Divider with "or" -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Height="1"
                                    Background="#5FA572"
                                    Opacity="0.3"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="or"
                                       Foreground="#9BB39E"
                                       FontFamily="Trebuchet MS"
                                       FontSize="11"
                                       Margin="12,0,12,0"/>
                            <Border Grid.Column="2"
                                    Height="1"
                                    Background="#5FA572"
                                    Opacity="0.3"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Sign in with Google (additional option, dark variant) -->
                        <Button Margin="0,16,0,0"
                                Height="44"
                                Background="#0D2818"
                                Foreground="#F5F0E8"
                                FontFamily="Trebuchet MS"
                                FontSize="14"
                                FontWeight="Bold"
                                BorderBrush="#4D5FA572"
                                BorderThickness="1"
                                Cursor="Hand"
                                Command="{Binding GoogleSignInCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Official Google "G" SVG (carries its own dark badge),
                                     rendered natively via SharpVectors -->
                                <svgc:SvgViewbox Source="/Assets/google-g-logo.svg"
                                                 Width="24" Height="24"
                                                 Margin="0,0,10,0"
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="Sign in with Google"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Register link -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <TextBlock Text="Don't have an account?"
                                       Foreground="#9BB39E"
                                       FontFamily="Trebuchet MS"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button Content="Create one →"
                                    Margin="6,0,0,0"
                                    Background="Transparent"
                                    Foreground="#D4A574"
                                    FontFamily="Trebuchet MS"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Padding="0"
                                    Command="{Binding GoToRegisterCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </Viewbox>

    </Grid>
</UserControl>