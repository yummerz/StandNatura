<UserControl x:Class="StandNatura.Views.SubmitSightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:v="clr-namespace:StandNatura.Views"
             mc:Ignorable="d">

    <!-- ============================================================
         SUBMIT SIGHTING VIEW
         Uses AppShell for header/menu chrome.
         Body is a two-pane layout:
           - Left (60%): grouped form fields
           - Right (40%): photo upload card
         ============================================================ -->

    <UserControl.Resources>

        <!-- Section header label style ("ABOUT", "WHERE IS IT?", etc.) -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9BB39E"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Field label style ("TITLE", "DESCRIPTION", etc.) -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#9BB39E"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Translucent input wrapper -->
        <Style x:Key="InputBorder" TargetType="Border">
            <Setter Property="Background" Value="#330D2818"/>
            <Setter Property="BorderBrush" Value="#5FA572"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- Translucent input textbox -->
        <Style x:Key="StyledTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F0E8"/>
            <Setter Property="CaretBrush" Value="#5FA572"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10,12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Trebuchet MS"/>
        </Style>

    </UserControl.Resources>

    <v:AppShell ActivePageKey="{Binding ActivePageKey}">
        <v:AppShell.PageContent>

            <!-- ─────────────────────────────────────────────────
                 LAYER: Solid dark green background
                 ───────────────────────────────────────────────── -->
            <Grid Background="#0D2818">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="40,30,40,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ─────────────────────────────────────
                             ROW 0: Page heading
                             ───────────────────────────────────── -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <TextBlock Text="{Binding HeaderText}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="#F5F0E8"
                                       FontFamily="Trebuchet MS"/>
                            <TextBlock Text="{Binding SubHeaderText}"
                                       FontSize="14"
                                       Foreground="#9BB39E"
                                       FontFamily="Trebuchet MS"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"
                                       MaxWidth="700"
                                       HorizontalAlignment="Left"/>
                        </StackPanel>

                        <!-- ─────────────────────────────────────
                             ROW 1: Two-pane content
                             ───────────────────────────────────── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ──────── LEFT PANE: Form fields ──────── -->
                            <Border Grid.Column="0"
                                    CornerRadius="10"
                                    Padding="30">
                                <Border.Background>
                                    <SolidColorBrush Color="#1F4030" Opacity="0.85"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#5FA572" Opacity="0.3"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>

                                <StackPanel>

                                    <!-- ═══ SECTION: ABOUT ═══ -->
                                    <TextBlock Text="ABOUT"
                                               Style="{StaticResource SectionHeader}"/>
                                    <Border Height="1"
                                            Background="#5FA572"
                                            Opacity="0.3"
                                            Margin="0,0,0,18"/>

                                    <!-- Title -->
                                    <TextBlock Text="TITLE"
                                               Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource InputBorder}">
                                        <TextBox Style="{StaticResource StyledTextBox}"
                                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>

                                    <!-- Description -->
                                    <TextBlock Text="DESCRIPTION"
                                               Style="{StaticResource FieldLabel}"
                                               Margin="0,18,0,6"/>
                                    <Border Style="{StaticResource InputBorder}">
                                        <TextBox Style="{StaticResource StyledTextBox}"
                                                 Height="100"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>

                                    <!-- ═══ SECTION: WHERE IS IT? ═══ -->
                                    <TextBlock Text="WHERE IS IT?"
                                               Style="{StaticResource SectionHeader}"
                                               Margin="0,30,0,4"/>
                                    <Border Height="1"
                                            Background="#5FA572"
                                            Opacity="0.3"
                                            Margin="0,0,0,18"/>

                                    <!-- Location -->
                                    <TextBlock Text="LOCATION (BARANGAY)"
                                               Style="{StaticResource FieldLabel}"/>
                                    <Border Style="{StaticResource InputBorder}">
                                        <TextBox Style="{StaticResource StyledTextBox}"
                                                 Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>

                                    <!-- Province + Region side by side -->
                                    <Grid Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="PROVINCE"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Border Style="{StaticResource InputBorder}">
                                                <TextBox Style="{StaticResource StyledTextBox}"
                                                         Text="{Binding Province, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="REGION"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Border Style="{StaticResource InputBorder}">
                                                <TextBox Style="{StaticResource StyledTextBox}"
                                                         Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ═══ SECTION: COORDINATES ═══ -->
                                    <TextBlock Text="COORDINATES"
                                               Style="{StaticResource SectionHeader}"
                                               Margin="0,30,0,4"/>
                                    <Border Height="1"
                                            Background="#5FA572"
                                            Opacity="0.3"
                                            Margin="0,0,0,18"/>

                                    <!-- Latitude + Longitude side by side -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="LATITUDE"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Border Style="{StaticResource InputBorder}">
                                                <TextBox Style="{StaticResource StyledTextBox}"
                                                         Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="LONGITUDE"
                                                       Style="{StaticResource FieldLabel}"/>
                                            <Border Style="{StaticResource InputBorder}">
                                                <TextBox Style="{StaticResource StyledTextBox}"
                                                         Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- ──────── RIGHT PANE: Photo upload ──────── -->
                            <Border Grid.Column="2"
                                    CornerRadius="10"
                                    Padding="30">
                                <Border.Background>
                                    <SolidColorBrush Color="#1F4030" Opacity="0.85"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#5FA572" Opacity="0.3"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Section header -->
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="EVIDENCE"
                                                   Style="{StaticResource SectionHeader}"/>
                                        <Border Height="1"
                                                Background="#5FA572"
                                                Opacity="0.3"
                                                Margin="0,0,0,18"/>
                                    </StackPanel>

                                    <!-- Photo preview area -->
                                    <Border Grid.Row="1"
                                            MinHeight="320"
                                            CornerRadius="6"
                                            BorderBrush="#5FA572"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <SolidColorBrush Color="#0D2818" Opacity="0.5"/>
                                        </Border.Background>
                                        <Grid>
                                            <!-- Empty state -->
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding PhotoPath,
                                                            Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="📷"
                                                           FontSize="48"
                                                           HorizontalAlignment="Center"
                                                           Opacity="0.5"/>
                                                <TextBlock Text="No photo yet"
                                                           Foreground="#9BB39E"
                                                           FontFamily="Trebuchet MS"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                                <TextBlock Text="Click 'Browse Photo' below to add evidence"
                                                           Foreground="#9BB39E"
                                                           FontFamily="Trebuchet MS"
                                                           FontStyle="Italic"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Image preview -->
                                            <Image Source="{Binding PhotoPath}"
                                                   Stretch="Uniform"
                                                   Margin="6"
                                                   Visibility="{Binding PhotoPath,
                                                       Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Browse button -->
                                    <Button Grid.Row="2"
                                            Content="📁 Browse Photo"
                                            Height="42"
                                            Margin="0,15,0,0"
                                            Background="#5FA572"
                                            Foreground="#0D2818"
                                            FontFamily="Trebuchet MS"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding BrowsePhotoCommand}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ─────────────────────────────────────
                             ROW 2: Action buttons
                             ───────────────────────────────────── -->
                        <Grid Grid.Row="2" Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cancel (secondary, outlined) -->
                            <Button Grid.Column="0"
                                    Content="← Cancel"
                                    Height="46"
                                    Width="160"
                                    Background="Transparent"
                                    Foreground="#D8E5DA"
                                    FontFamily="Trebuchet MS"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    BorderBrush="#5FA572"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Command="{Binding CancelCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <!-- Submit (primary, filled) -->
                            <Button Grid.Column="2"
                                    Content="{Binding SubmitButtonText}"
                                    Height="46"
                                    Width="220"
                                    Background="#5FA572"
                                    Foreground="#0D2818"
                                    FontFamily="Trebuchet MS"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding SubmitSightingCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

        </v:AppShell.PageContent>
    </v:AppShell>
</UserControl>