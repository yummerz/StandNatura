<UserControl x:Class="StandNatura.Views.SubmitSightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="{Binding HeaderText}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#74C69D"
                       FontFamily="Trebuchet MS"/>
            <TextBlock Text="{Binding SubHeaderText}"
                       FontSize="13"
                       Foreground="#95D5B2"
                       FontFamily="Trebuchet MS"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Form Fields -->
            <ScrollViewer Grid.Column="0" 
                          Margin="0,0,10,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="Title"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#95D5B2"
                               FontFamily="Trebuchet MS"
                               Margin="0,0,0,5"/>
                    <TextBox Background="#2D6A4F"
                             Foreground="#FFFFFF"
                             BorderBrush="#52B788"
                             BorderThickness="2"
                             Padding="5,8,5,8"
                             FontSize="13"
                             FontFamily="Trebuchet MS"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Description -->
                    <TextBlock Text="Description"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#95D5B2"
                               FontFamily="Trebuchet MS"
                               Margin="0,15,0,5"/>
                    <TextBox Background="#2D6A4F"
                             Foreground="#FFFFFF"
                             BorderBrush="#52B788"
                             BorderThickness="2"
                             Padding="5,8,5,8"
                             FontSize="13"
                             FontFamily="Trebuchet MS"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Location -->
                    <TextBlock Text="Location (Barangay)"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#95D5B2"
                               FontFamily="Trebuchet MS"
                               Margin="0,15,0,5"/>
                    <TextBox Background="#2D6A4F"
                             Foreground="#FFFFFF"
                             BorderBrush="#52B788"
                             BorderThickness="2"
                             Padding="5,8,5,8"
                             FontSize="13"
                             FontFamily="Trebuchet MS"
                             Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Province and Region side by side -->
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Province"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,0,0,5"/>
                            <TextBox Background="#2D6A4F"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#52B788"
                                     BorderThickness="2"
                                     Padding="5,8,5,8"
                                     FontSize="13"
                                     FontFamily="Trebuchet MS"
                                     Text="{Binding Province, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Region"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,0,0,5"/>
                            <TextBox Background="#2D6A4F"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#52B788"
                                     BorderThickness="2"
                                     Padding="5,8,5,8"
                                     FontSize="13"
                                     FontFamily="Trebuchet MS"
                                     Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Longitude and Latitude side by side -->
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Longitude"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,0,0,5"/>
                            <TextBox Background="#2D6A4F"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#52B788"
                                     BorderThickness="2"
                                     Padding="5,8,5,8"
                                     FontSize="13"
                                     FontFamily="Trebuchet MS"
                                     Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Latitude"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       Margin="0,0,0,5"/>
                            <TextBox Background="#2D6A4F"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#52B788"
                                     BorderThickness="2"
                                     Padding="5,8,5,8"
                                     FontSize="13"
                                     FontFamily="Trebuchet MS"
                                     Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Right: Photo Upload -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Photo"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#95D5B2"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,8"/>

                <!-- Image Preview Box -->
                <Border Grid.Row="1"
                        Background="#2D6A4F"
                        BorderBrush="#52B788"
                        BorderThickness="2">
                    <Grid>
                        <!-- No photo message -->
                        <TextBlock Text="🖼️ No photo selected"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding PhotoPath,
                                       Converter={StaticResource NullToVisibilityConverter}}"/>

                        <!-- Image Preview -->
                        <Image Stretch="Uniform"
                            Source="{Binding PhotoPath}"
                            Visibility="{Binding PhotoPath,
                            Converter={StaticResource NotNullToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Browse Button -->
                <Button Grid.Row="2"
                        Content="📁 Browse Photo"
                        Height="40"
                        Margin="0,10,0,0"
                        Background="#52B788"
                        Foreground="#1B4332"
                        FontFamily="Trebuchet MS"
                        FontSize="13" FontWeight="Bold"
                        BorderBrush="#74C69D" BorderThickness="2"
                        Command="{Binding BrowsePhotoCommand}"/>
            </Grid>
        </Grid>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Back"
                    Height="45"
                    Margin="0,0,10,0"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoBackCommand}"/>

            <Button Grid.Column="1"
                    Content="{Binding SubmitButtonText}"
                    Height="45"
                    Background="#52B788"
                    Foreground="#1B4332"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#74C69D" BorderThickness="2"
                    Command="{Binding SubmitSightingCommand}"/>
        </Grid>
    </Grid>
</UserControl>