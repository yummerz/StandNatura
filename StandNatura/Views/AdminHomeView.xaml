<UserControl x:Class="StandNatura.Views.AdminHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,20,20,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🌿 StandNatura"
                           FontSize="42" FontWeight="Bold"
                           Foreground="#74C69D"
                           HorizontalAlignment="Center"
                           FontFamily="Trebuchet MS"/>
                <TextBlock Text="Admin Dashboard"
                           FontSize="16"
                           Foreground="#95D5B2"
                           HorizontalAlignment="Center"
                           FontFamily="Trebuchet MS"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Logout Button Top Right -->
            <Button Content="🚪 Logout"
                    Width="100" Height="35"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#B7374A"
                    Foreground="#FFFFFF"
                    FontFamily="Trebuchet MS"
                    FontSize="12" FontWeight="Bold"
                    BorderBrush="#E05C6E" BorderThickness="2"
                    Command="{Binding LogoutCommand}"/>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="320">

            <Button Content="✅  Verify Posts"
                    Width="320" Height="55"
                    Margin="0,0,0,15"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="16" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoToVerifyPostsCommand}"/>

            <Button Content="👤  Manage Users"
                    Width="320" Height="55"
                    Margin="0,0,0,15"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="16" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoToManageUsersCommand}"/>

            <Button Content="🌍  Sighting Feed Overview"
                    Width="320" Height="55"
                    Margin="0,0,0,15"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="16" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoToSightingFeedCommand}"/>

            <Button Content="💰  Donations &amp; Funds"
                    Width="320" Height="55"
                    Margin="0,0,0,15"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="16" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoToDonationsFundsCommand}"/>

            <Button Content="🔍  Hidden Sightings"
                    Width="320" Height="55"
                    Margin="0,0,0,15"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="16" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoToHiddenSightingsCommand}"/>

        </StackPanel>
    </Grid>
</UserControl>