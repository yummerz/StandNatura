<UserControl x:Class="StandNatura.Views.HiddenSightingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="🔍 Hidden Sightings"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#74C69D"
                       FontFamily="Trebuchet MS"/>
            <TextBlock Text="Sightings under investigation. Restore to public feed or archive permanently."
                       FontSize="13"
                       Foreground="#95D5B2"
                       FontFamily="Trebuchet MS"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Hidden Sightings List -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Under Investigation"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,8"/>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding HiddenSightings}"
                         SelectedItem="{Binding SelectedSighting}"
                         Background="#2D6A4F"
                         Foreground="#D8F3DC"
                         BorderBrush="#52B788"
                         BorderThickness="2">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6,8,6">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS"
                                           TextWrapping="Wrap"/>
                                <TextBlock FontSize="12"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS">
                                    <Run Text="By "/>
                                    <Run Text="{Binding Username}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Province}"
                                           FontSize="12"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Right: Selected Sighting Details -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Details"
                           FontSize="15" FontWeight="Bold"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,8"/>

                <Border Grid.Row="1"
                        Background="#2D6A4F"
                        BorderBrush="#52B788"
                        BorderThickness="2"
                        Padding="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- No selection message -->
                            <TextBlock Text="Select a sighting from the list to view details."
                                       Foreground="#95D5B2"
                                       FontFamily="Trebuchet MS"
                                       FontSize="13"
                                       Visibility="{Binding SelectedSighting,
                                           Converter={StaticResource NullToVisibilityConverter}}"/>

                            <!-- Details panel -->
                            <StackPanel Visibility="{Binding SelectedSighting,
                                            Converter={StaticResource NotNullToVisibilityConverter}}">

                                <!-- Top: Title and Photo -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SelectedSighting.Title}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="#74C69D"
                                                   FontFamily="Trebuchet MS"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="#95D5B2"
                                                   FontFamily="Trebuchet MS"
                                                   Margin="0,4,0,0">
                                            <Run Text="By "/>
                                            <Run Text="{Binding SelectedSighting.Username}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SelectedSighting.DatePosted}"
                                                   FontSize="11"
                                                   Foreground="#95D5B2"
                                                   FontFamily="Trebuchet MS"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#1B4332"
                                            BorderBrush="#52B788"
                                            BorderThickness="2"
                                            Height="180">
                                        <Grid>
                                            <TextBlock Text="No Photo"
                                                       Foreground="#95D5B2"
                                                       FontFamily="Trebuchet MS"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding SelectedSighting.Photo,
                                                           Converter={StaticResource NullToVisibilityConverter}}"/>
                                            <Image Source="{Binding SelectedSighting.Photo,
                                                    Converter={StaticResource FilePathToImageConverter}}"
                                                   Stretch="Uniform"
                                                   Visibility="{Binding SelectedSighting.Photo,
                                                       Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Separator Background="#52B788" Margin="0,15,0,15"/>

                                <TextBlock Text="Description"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedSighting.Description}"
                                           FontSize="13"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Location"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"
                                           Margin="0,12,0,2"/>
                                <TextBlock Text="{Binding SelectedSighting.Location}"
                                           FontSize="13"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS"/>

                                <TextBlock Text="Province / Region"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"
                                           Margin="0,12,0,2"/>
                                <TextBlock FontSize="13"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS">
                                    <Run Text="{Binding SelectedSighting.Province}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding SelectedSighting.Region}"/>
                                </TextBlock>

                                <TextBlock Text="Coordinates"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"
                                           Margin="0,12,0,2"/>
                                <TextBlock FontSize="13"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS">
                                    <Run Text="Lat: "/>
                                    <Run Text="{Binding SelectedSighting.Latitude}"/>
                                    <Run Text="  Long: "/>
                                    <Run Text="{Binding SelectedSighting.Longitude}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Buttons -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="← Back"
                    Height="45"
                    Margin="0,0,10,0"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoBackCommand}"/>

            <Button Grid.Column="1"
                    Content="✅ Restore"
                    Height="45"
                    Margin="0,0,10,0"
                    Background="#52B788"
                    Foreground="#1B4332"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#74C69D" BorderThickness="2"
                    Command="{Binding RestoreCommand}"/>

            <Button Grid.Column="2"
                    Content="📦 Archive"
                    Height="45"
                    Background="#B7374A"
                    Foreground="#FFFFFF"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#E05C6E" BorderThickness="2"
                    Command="{Binding ArchiveCommand}"/>
        </Grid>
    </Grid>
</UserControl>