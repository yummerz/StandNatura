<UserControl x:Class="StandNatura.Views.SightingDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,20,20,10">
            <StackPanel>
                <TextBlock Text="{Binding Sighting.Title}"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#74C69D"
                           FontFamily="Trebuchet MS"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="12"
                           Foreground="#95D5B2"
                           FontFamily="Trebuchet MS"
                           Margin="0,4,0,0">
                    <Run Text="By "/>
                    <Run Text="{Binding Sighting.Username}" FontWeight="Bold"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding Sighting.DatePosted}"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,10">

                <!-- Photo -->
                <Border Height="350"
                        Background="#2D6A4F"
                        BorderBrush="#52B788"
                        BorderThickness="2"
                        Margin="0,0,0,15">
                    <Grid>
                        <TextBlock Text="🌿 No Photo Available"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Sighting.Photo,
                                       Converter={StaticResource NullToVisibilityConverter}}"/>
                        <Image Source="{Binding Sighting.Photo, 
                                Converter={StaticResource FilePathToImageConverter}}"
                                Stretch="Uniform"
                                Visibility="{Binding Sighting.Photo,
                                Converter={StaticResource NotNullToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Details -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Location"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"/>
                        <TextBlock Text="{Binding Sighting.Location}"
                                   FontSize="13"
                                   Foreground="#D8F3DC"
                                   FontFamily="Trebuchet MS"/>
                        <TextBlock FontSize="13"
                                   Foreground="#D8F3DC"
                                   FontFamily="Trebuchet MS">
                            <Run Text="{Binding Sighting.Province}"/>
                            <Run Text=", "/>
                            <Run Text="{Binding Sighting.Region}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Coordinates"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"/>
                        <TextBlock FontSize="13"
                                   Foreground="#D8F3DC"
                                   FontFamily="Trebuchet MS">
                            <Run Text="Lat: "/>
                            <Run Text="{Binding Sighting.Latitude}"/>
                        </TextBlock>
                        <TextBlock FontSize="13"
                                   Foreground="#D8F3DC"
                                   FontFamily="Trebuchet MS">
                            <Run Text="Long: "/>
                            <Run Text="{Binding Sighting.Longitude}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Description -->
                <TextBlock Text="About this Sighting"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#95D5B2"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Sighting.Description}"
                           FontSize="13"
                           Foreground="#D8F3DC"
                           FontFamily="Trebuchet MS"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- Petition Section -->
                <Border Background="#2D6A4F"
        BorderBrush="#52B788"
        BorderThickness="2"
        Padding="15"
        Margin="0,0,0,15">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Protection Demand"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#74C69D"
                       FontFamily="Trebuchet MS"/>
                            <TextBlock FontSize="13"
                       Foreground="#D8F3DC"
                       FontFamily="Trebuchet MS">
                <Run Text="{Binding DemandCount}"/>
                <Run Text=" signatures demanding government protection"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="1"
                Content="{Binding PetitionButtonText}"
                Height="40" Width="150"
                Background="#52B788"
                Foreground="#1B4332"
                FontFamily="Trebuchet MS"
                FontSize="12" FontWeight="Bold"
                BorderBrush="#74C69D" BorderThickness="2"
                Command="{Binding SignPetitionCommand}"/>
                    </Grid>
                </Border>

                <!-- Donation Section -->
                <Border Background="#2D6A4F"
                        BorderBrush="#52B788"
                        BorderThickness="2"
                        Padding="15"
                        Margin="0,0,0,15">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="💰 Support This Sanctuary"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#74C69D"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,0,0,5"/>
                        <TextBlock FontSize="13"
                                   Foreground="#D8F3DC"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,0,0,10">
                            <Run Text="Total Funds Raised: "/>
                            <Run Text="{Binding TotalFunds, StringFormat='₱{0:N2}'}"
                                 FontWeight="Bold" Foreground="#74C69D"/>
                        </TextBlock>
                        <TextBlock Text="Donate to unlock commenting on this sighting."
                                   FontSize="12"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Background="#1B4332"
                                     Foreground="#FFFFFF"
                                     BorderBrush="#52B788"
                                     BorderThickness="2"
                                     Padding="5,8,5,8"
                                     FontSize="13"
                                     FontFamily="Trebuchet MS"
                                     Margin="0,0,10,0"
                                     Text="{Binding DonationAmount, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1"
                                    Content="₱ Donate"
                                    Height="38" Width="100"
                                    Background="#52B788"
                                    Foreground="#1B4332"
                                    FontFamily="Trebuchet MS"
                                    FontSize="13" FontWeight="Bold"
                                    BorderBrush="#74C69D" BorderThickness="2"
                                    Command="{Binding DonateCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Comments Section -->
                <TextBlock Text="💬 Comments"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#74C69D"
                           FontFamily="Trebuchet MS"
                           Margin="0,0,0,10"/>

                <!-- Comment Input -->
                <Border Background="#2D6A4F"
                        BorderBrush="#52B788"
                        BorderThickness="2"
                        Padding="15"
                        Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="12"
                                   Foreground="#95D5B2"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding CanComment,
                                       Converter={StaticResource NotNullToVisibilityConverter}}">
                            <Run Text="You have donated to this sanctuary. Leave a comment below!"/>
                        </TextBlock>
                        <TextBlock Text="You must donate first to leave a comment."
                                   FontSize="12"
                                   Foreground="#E05C6E"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding CanComment,
                                       Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBox Background="#1B4332"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#52B788"
                                 BorderThickness="2"
                                 Padding="5,8,5,8"
                                 FontSize="13"
                                 FontFamily="Trebuchet MS"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsEnabled="{Binding CanComment}"
                                 Text="{Binding CommentText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Post Comment"
                                Height="38"
                                Margin="0,10,0,0"
                                Background="#52B788"
                                Foreground="#1B4332"
                                FontFamily="Trebuchet MS"
                                FontSize="13" FontWeight="Bold"
                                BorderBrush="#74C69D" BorderThickness="2"
                                IsEnabled="{Binding CanComment}"
                                Command="{Binding PostCommentCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Comments List -->
                <ItemsControl ItemsSource="{Binding Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2D6A4F"
                    BorderBrush="#52B788"
                    BorderThickness="2"
                    Padding="12"
                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="13" FontWeight="Bold"
                                   Foreground="#74C69D"
                                   FontFamily="Trebuchet MS">
                            <Run Text="{Binding DonorUsername}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Amount, StringFormat='₱{0:N2}'}"
                                 Foreground="#52B788"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CommentText}"
                                   FontSize="13"
                                   Foreground="#D8F3DC"
                                   FontFamily="Trebuchet MS"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                                    </StackPanel>

                                    <!-- Delete button (admin only) -->
                                    <Button Grid.Column="1"
                            Content="🗑️"
                            Width="35" Height="35"
                            VerticalAlignment="Top"
                            Margin="10,0,0,0"
                            Background="#B7374A"
                            Foreground="#FFFFFF"
                            FontFamily="Trebuchet MS"
                            FontSize="14" FontWeight="Bold"
                            BorderBrush="#E05C6E" BorderThickness="2"
                            ToolTip="Delete this comment"
                            Command="{Binding DataContext.DeleteCommentCommand,
                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.IsAdmin,
                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Back Button -->
        <Grid Grid.Row="2" Margin="20,10,20,20">
            <Button Content="← Back to Feed"
                    Height="45"
                    HorizontalAlignment="Left"
                    Width="200"
                    Background="#2D6A4F"
                    Foreground="#D8F3DC"
                    FontFamily="Trebuchet MS"
                    FontSize="14" FontWeight="Bold"
                    BorderBrush="#52B788" BorderThickness="2"
                    Command="{Binding GoBackCommand}"/>
        </Grid>
    </Grid>
</UserControl>