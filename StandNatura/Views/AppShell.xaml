<UserControl x:Class="StandNatura.Views.AppShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="ShellRoot">

    <UserControl.Resources>
        <!-- Menu item button style — clean hover with green tint -->
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="25,12,25,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#D8E5DA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#5FA572" Opacity="0.10"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ============================================================
         APP SHELL
         Provides the top header bar + hamburger drawer for any
         contributor view. The host view's content is injected into
         the "MainContentArea" placeholder via the PageContent property.
         ============================================================ -->

    <Grid x:Name="RootGrid">

        <!-- ─────────────────────────────────────────────────
             ROW 1: Top header bar
             ROW 2: Page content (host view's content lives here)
             ───────────────────────────────────────────────── -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ────────── Top header bar ────────── -->
            <Border Grid.Row="0"
                    Padding="20,15,30,15"
                    BorderBrush="#5FA572"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <SolidColorBrush Color="#0D2818" Opacity="0.95"/>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hamburger toggle + brand mark -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Hamburger button -->
                        <Button Width="40" Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MenuToggleButton_Click">
                            <Path Stroke="#F5F0E8"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 4,8 H 24 M 4,14 H 24 M 4,20 H 24"/>
                        </Button>

                        <!-- Mini leaf logo + wordmark -->
                        <Path Width="28" Height="28"
                              Margin="15,0,8,0"
                              Stroke="#5FA572"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stretch="Uniform"
                              Data="M 50,5 C 20,15 5,40 10,75 C 40,75 75,55 80,15 C 70,12 60,10 50,5 Z M 18,68 C 35,55 55,40 65,20"
                              VerticalAlignment="Center">
                            <Path.Effect>
                                <DropShadowEffect Color="#5FA572"
                                                  BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.6"/>
                            </Path.Effect>
                        </Path>
                        <TextBlock Text="StandNatura"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F0E8"
                                   FontFamily="Trebuchet MS"
                                   VerticalAlignment="Center"
                                   Typography.Capitals="AllSmallCaps"/>
                    </StackPanel>

                    <!-- Welcome label on the right -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding WelcomeMessage}"
                               FontSize="14"
                               Foreground="#9BB39E"
                               FontFamily="Trebuchet MS"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ────────── Main content area ────────── -->
            <!-- The host view's content is placed here at runtime.
                 The host XAML sets <v:AppShell.PageContent>...</v:AppShell.PageContent> -->
            <ContentPresenter Grid.Row="1"
                              Content="{Binding PageContent, ElementName=ShellRoot}"/>
        </Grid>

        <!-- ─────────────────────────────────────────────────
             Menu dim overlay (covers everything when menu is open)
             ───────────────────────────────────────────────── -->
        <Rectangle x:Name="MenuDimOverlay"
                   Fill="Black"
                   Opacity="0"
                   IsHitTestVisible="False"
                   MouseDown="MenuDimOverlay_MouseDown"/>

        <!-- ─────────────────────────────────────────────────
             Sliding hamburger menu panel
             ───────────────────────────────────────────────── -->
        <Border x:Name="MenuPanel"
                Width="320"
                HorizontalAlignment="Left"
                BorderThickness="0,0,1,0"
                BorderBrush="#5FA572">
            <Border.Background>
                <SolidColorBrush Color="#0D2818" Opacity="0.95"/>
            </Border.Background>
            <Border.RenderTransform>
                <TranslateTransform X="-320"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.6"
                                  Direction="0"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Menu header: brand + close -->
                <Grid Grid.Row="0" Margin="25,25,20,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="32" Height="32"
                              Stroke="#5FA572"
                              StrokeThickness="2.5"
                              StrokeLineJoin="Round"
                              Fill="Transparent"
                              Stretch="Uniform"
                              Data="M 50,5 C 20,15 5,40 10,75 C 40,75 75,55 80,15 C 70,12 60,10 50,5 Z M 18,68 C 35,55 55,40 65,20">
                            <Path.Effect>
                                <DropShadowEffect Color="#5FA572"
                                                  BlurRadius="15"
                                                  ShadowDepth="0"
                                                  Opacity="0.7"/>
                            </Path.Effect>
                        </Path>
                        <TextBlock Text="StandNatura"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F0E8"
                                   FontFamily="Trebuchet MS"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Typography.Capitals="AllSmallCaps"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="36" Height="36"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Click="MenuToggleButton_Click">
                        <Path Stroke="#F5F0E8"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 6,6 L 18,18 M 18,6 L 6,18"/>
                    </Button>
                </Grid>

                <!-- Menu items -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">

                    <!-- Welcome -->
                    <StackPanel Margin="25,0,25,25">
                        <TextBlock Text="WELCOME"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#9BB39E"
                                   FontFamily="Trebuchet MS"/>
                        <TextBlock Text="{Binding WelcomeMessage}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F0E8"
                                   FontFamily="Trebuchet MS"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1"
                            Background="#5FA572"
                            Opacity="0.25"
                            Margin="25,0,25,15"/>

                    <!-- Home -->
                    <Grid x:Name="MenuItem_Home">
                        <!-- Active accent (left bar) — visible only when active -->
                        <Rectangle x:Name="MenuItem_Home_Accent"
                                   Width="3"
                                   HorizontalAlignment="Left"
                                   Fill="#5FA572"
                                   Visibility="Collapsed"/>
                        <Button Style="{StaticResource MenuItemButton}"
                                Click="MenuItem_Click"
                                Command="{Binding GoToHomeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock x:Name="MenuItem_Home_Text"
                                           Text="Home"
                                           FontSize="14"
                                           Foreground="#D8E5DA"
                                           FontFamily="Trebuchet MS"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Submit Sighting -->
                    <Grid x:Name="MenuItem_Submit">
                        <Rectangle x:Name="MenuItem_Submit_Accent"
                                   Width="3"
                                   HorizontalAlignment="Left"
                                   Fill="#5FA572"
                                   Visibility="Collapsed"/>
                        <Button Style="{StaticResource MenuItemButton}"
                                Click="MenuItem_Click"
                                Command="{Binding GoToSubmitSightingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📍"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock x:Name="MenuItem_Submit_Text"
                                           Text="Submit Sighting"
                                           FontSize="14"
                                           Foreground="#D8E5DA"
                                           FontFamily="Trebuchet MS"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- My Sightings -->
                    <Grid x:Name="MenuItem_MySightings">
                        <Rectangle x:Name="MenuItem_MySightings_Accent"
                                   Width="3"
                                   HorizontalAlignment="Left"
                                   Fill="#5FA572"
                                   Visibility="Collapsed"/>
                        <Button Style="{StaticResource MenuItemButton}"
                                Click="MenuItem_Click"
                                Command="{Binding GoToMySightingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌿"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock x:Name="MenuItem_MySightings_Text"
                                           Text="My Sightings"
                                           FontSize="14"
                                           Foreground="#D8E5DA"
                                           FontFamily="Trebuchet MS"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Hotspot Map -->
                    <Grid x:Name="MenuItem_HotspotMap">
                        <Rectangle x:Name="MenuItem_HotspotMap_Accent"
                                   Width="3"
                                   HorizontalAlignment="Left"
                                   Fill="#5FA572"
                                   Visibility="Collapsed"/>
                        <Button Style="{StaticResource MenuItemButton}"
                                Click="MenuItem_Click"
                                Command="{Binding GoToHotspotMapCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗺️"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBlock x:Name="MenuItem_HotspotMap_Text"
                                           Text="Hotspot Map"
                                           FontSize="14"
                                           Foreground="#D8E5DA"
                                           FontFamily="Trebuchet MS"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>

                <!-- Logout (bottom) -->
                <StackPanel Grid.Row="2" Margin="25,0,25,25">
                    <Border Height="1"
                            Background="#5FA572"
                            Opacity="0.25"
                            Margin="0,0,0,15"/>
                    <Button Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="#C45A3E"
                            HorizontalContentAlignment="Center"
                            Padding="0,10,0,10"
                            Cursor="Hand"
                            Click="MenuItem_Click"
                            Command="{Binding LogoutCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚪"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Logout"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#C45A3E"
                                       FontFamily="Trebuchet MS"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>