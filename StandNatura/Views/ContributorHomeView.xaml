<UserControl x:Class="StandNatura.Views.ContributorHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:v="clr-namespace:StandNatura.Views"
             mc:Ignorable="d">

    <!-- ============================================================
         CONTRIBUTOR HOME VIEW
         Now uses the AppShell for header bar + hamburger menu.
         This file only contains the HOME-SPECIFIC content (background
         photo + section title + card grid). All navigation chrome
         lives in AppShell.
         ============================================================ -->

    <v:AppShell ActivePageKey="{Binding ActivePageKey}">
        <v:AppShell.PageContent>

            <Grid>

                <!-- ─────────────────────────────────────────────────
                     LAYER 1: Background photo
                     ───────────────────────────────────────────────── -->
                <Image Source="/Assets/HomeBackground.jpg"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False"/>

                <!-- ─────────────────────────────────────────────────
                     LAYER 2: Heavy darkening overlay
                     ───────────────────────────────────────────────── -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <SolidColorBrush Color="#0D2818" Opacity="0.75"/>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ─────────────────────────────────────────────────
                     LAYER 3: Page content
                     ───────────────────────────────────────────────── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="40,30,40,30">

                        <!-- Section title -->
                        <TextBlock Text="Community Sightings"
                                   FontSize="32"
                                   FontWeight="SemiBold"
                                   Foreground="#F5F0E8"
                                   FontFamily="Trebuchet MS"/>
                        <TextBlock Text="Sanctuaries discovered by our community of defenders"
                                   FontSize="14"
                                   Foreground="#9BB39E"
                                   FontFamily="Trebuchet MS"
                                   FontStyle="Italic"
                                   Margin="0,4,0,30"/>

                        <!-- Card grid: 3 cards per row -->
                        <ItemsControl ItemsSource="{Binding Sightings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <!-- Card -->
                                    <Border Margin="10"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1F4030" Opacity="0.85"/>
                                        </Border.Background>
                                        <Border.BorderBrush>
                                            <SolidColorBrush Color="#5FA572" Opacity="0.3"/>
                                        </Border.BorderBrush>
                                        <Border.BorderThickness>1</Border.BorderThickness>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000"
                                                              BlurRadius="20"
                                                              ShadowDepth="0"
                                                              Opacity="0.4"/>
                                        </Border.Effect>

                                        <StackPanel>

                                            <!-- Photo (top of card) -->
                                            <Border Height="180"
                                                    Background="#0D2818">
                                                <Grid>
                                                    <TextBlock Text="🌿 No Photo"
                                                               Foreground="#9BB39E"
                                                               FontFamily="Trebuchet MS"
                                                               FontSize="13"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding Photo,
                                                                   Converter={StaticResource NullToVisibilityConverter}}"/>
                                                    <Image Source="{Binding Photo,
                                                            Converter={StaticResource FilePathToImageConverter}}"
                                                           Stretch="UniformToFill"
                                                           Visibility="{Binding Photo,
                                                               Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <!-- Card body -->
                                            <StackPanel Margin="18,14,18,18">

                                                <!-- Title -->
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F5F0E8"
                                                           FontFamily="Trebuchet MS"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="48"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <!-- Contributor -->
                                                <TextBlock FontSize="12"
                                                           Foreground="#D4A574"
                                                           FontFamily="Trebuchet MS"
                                                           Margin="0,6,0,0">
                                                    <Run Text="By "/>
                                                    <Run Text="{Binding Username}" FontWeight="Bold"/>
                                                </TextBlock>

                                                <!-- Province -->
                                                <TextBlock FontSize="12"
                                                           Foreground="#9BB39E"
                                                           FontFamily="Trebuchet MS"
                                                           Margin="0,3,0,0">
                                                    <Run Text="📍 "/>
                                                    <Run Text="{Binding Province}"/>
                                                </TextBlock>

                                                <!-- View Sighting button -->
                                                <Button Content="View Sighting →"
                                                        Margin="0,16,0,0"
                                                        Height="38"
                                                        Background="#5FA572"
                                                        Foreground="#0D2818"
                                                        FontFamily="Trebuchet MS"
                                                        FontSize="13"
                                                        FontWeight="Bold"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        Command="{Binding DataContext.ViewSightingCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </v:AppShell.PageContent>
    </v:AppShell>
</UserControl>