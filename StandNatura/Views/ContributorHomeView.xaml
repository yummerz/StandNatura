<UserControl x:Class="StandNatura.Views.ContributorHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Background="#1B4332">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Community Feed -->
        <Grid Grid.Column="0" Margin="20,20,10,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Feed Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="🌿 StandNatura"
                           FontSize="32" FontWeight="Bold"
                           Foreground="#74C69D"
                           FontFamily="Trebuchet MS"/>
                <TextBlock Text="Community Sighting Feed"
                           FontSize="14"
                           Foreground="#95D5B2"
                           FontFamily="Trebuchet MS"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Feed List -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Sightings}"
                     SelectedItem="{Binding SelectedSighting}"
                     Background="#2D6A4F"
                     Foreground="#D8F3DC"
                     BorderBrush="#52B788"
                     BorderThickness="2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="5" Padding="12"
                                Background="#1B4332"
                                CornerRadius="4">
                            <StackPanel>
                                <!-- Photo Preview -->
                                <Border Height="150"
                                        Background="#2D6A4F"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <TextBlock Text="🌿 No Photo"
                                                   Foreground="#95D5B2"
                                                   FontFamily="Trebuchet MS"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Photo,
                                                       Converter={StaticResource NullToVisibilityConverter}}"/>
                                        <Image Source="{Binding SelectedSighting.Photo, 
                                            Converter={StaticResource FilePathToImageConverter}}"
                                            Stretch="UniformToFill"
                                            Visibility="{Binding SelectedSighting.Photo,
                                            Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Sighting Info -->
                                <TextBlock Text="{Binding Title}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#74C69D"
                                           FontFamily="Trebuchet MS"
                                           TextWrapping="Wrap"/>
                                <TextBlock FontSize="12"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS"
                                           Margin="0,4,0,0">
                                    <Run Text="By "/>
                                    <Run Text="{Binding Username}" FontWeight="Bold"/>
                                </TextBlock>
                                <TextBlock FontSize="12"
                                           Foreground="#95D5B2"
                                           FontFamily="Trebuchet MS">
                                    <Run Text="{Binding Location}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding Province}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding DatePosted}"
                                           FontSize="11"
                                           Foreground="#74C69D"
                                           FontFamily="Trebuchet MS"
                                           Margin="0,4,0,8"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#D8F3DC"
                                           FontFamily="Trebuchet MS"
                                           TextWrapping="Wrap"
                                           MaxHeight="60"/>

                                <!-- View Button -->
                                <Button Content="View Sighting →"
                                        Margin="0,10,0,0"
                                        Background="#52B788"
                                        Foreground="#1B4332"
                                        FontFamily="Trebuchet MS"
                                        FontSize="12" FontWeight="Bold"
                                        Padding="8,6,8,6"
                                        BorderBrush="#74C69D" BorderThickness="1"
                                        Command="{Binding DataContext.ViewSightingCommand,
                                            RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right: Navigation Menu -->
        <Grid Grid.Column="1" Background="#2D6A4F" Margin="0">
            <StackPanel VerticalAlignment="Top" Margin="10,20,10,0">

                <!-- Welcome -->
                <TextBlock Text="{Binding WelcomeMessage}"
                           FontSize="12" FontWeight="Bold"
                           Foreground="#74C69D"
                           FontFamily="Trebuchet MS"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button Content="📍 Submit"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#1B4332"
                        Foreground="#D8F3DC"
                        FontFamily="Trebuchet MS"
                        FontSize="13" FontWeight="Bold"
                        BorderBrush="#52B788" BorderThickness="2"
                        Command="{Binding GoToSubmitSightingCommand}"/>

                <Button Content="🌿 My Sightings"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#1B4332"
                        Foreground="#D8F3DC"
                        FontFamily="Trebuchet MS"
                        FontSize="13" FontWeight="Bold"
                        BorderBrush="#52B788" BorderThickness="2"
                        Command="{Binding GoToMySightingsCommand}"/>

                <Button Content="🗺️ Map"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#1B4332"
                        Foreground="#D8F3DC"
                        FontFamily="Trebuchet MS"
                        FontSize="13" FontWeight="Bold"
                        BorderBrush="#52B788" BorderThickness="2"
                        Command="{Binding GoToHotspotMapCommand}"/>

                <!-- Logout at bottom -->
                <Button Content="🚪 Logout"
                        Height="40"
                        Margin="0,30,0,0"
                        Background="#B7374A"
                        Foreground="#FFFFFF"
                        FontFamily="Trebuchet MS"
                        FontSize="12" FontWeight="Bold"
                        BorderBrush="#E05C6E" BorderThickness="2"
                        Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>